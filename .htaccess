# Health&Beauty Cazin - Apache config for cPanel hosting

# Force HTTPS and the bare domain (https://healthandbeauty.ba/), matching the canonical URLs
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Leave certificate-validation requests (AutoSSL / Let's Encrypt) alone
    RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^ https://healthandbeauty.ba%{REQUEST_URI} [L,R=301]

    # /index.html -> /
    RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
    RewriteRule ^index\.html$ / [L,R=301]
</IfModule>

DirectoryIndex index.html
Options -Indexes

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript image/svg+xml application/ld+json
</IfModule>

# Browser caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 week"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/svg+xml "access plus 6 months"
    ExpiresByType image/x-icon "access plus 6 months"
</IfModule>

# Basic security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
